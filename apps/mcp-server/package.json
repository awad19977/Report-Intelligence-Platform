{
  "name": "@report-intelligence/mcp-server",
  "version": "0.1.2",
  "description": "MCP server exposing validated read-only Crystal Reports inspection with automatic Community or Pro worker discovery on Windows.",
  "license": "LGPL-3.0-only",
  "author": "Awad Emad",
  "homepage": "https://github.com/awad19977/Report-Intelligence-Platform#readme",
  "bugs": { "url": "https://github.com/awad19977/Report-Intelligence-Platform/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awad19977/Report-Intelligence-Platform.git",
    "directory": "apps/mcp-server"
  },
  "keywords": ["mcp", "crystal-reports", "reporting", "typescript"],
  "type": "module",
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "report-intelligence-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build --workspace=@report-intelligence/crystal-client && npm run build",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@report-intelligence/core": "^0.1.0",
    "@report-intelligence/crystal-client": "^0.1.0",
    "@report-intelligence/plugin-api": "^0.1.0",
    "zod": "^3.22.0",
    "winston": "^3.11.0"
  },
  "optionalDependencies": {
    "@report-intelligence/crystal-worker-community-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
