# Package managers and dependencies
node_modules/
.pnp
.pnp.*
.npm/
.yarn/

# Compiled output
dist/
build/
out/
lib/
bin/
obj/
*.tsbuildinfo

# Reviewed binary-only Community worker distribution. The worker source remains private.
!distributions/
!distributions/crystal-worker-community-win32-x64/
!distributions/crystal-worker-community-win32-x64/bin/
!distributions/crystal-worker-community-win32-x64/bin/**

# Test and tool output
coverage/
.nyc_output/
.vitest/
**/.vite/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.pfx
*.p12
*.snk

# Editor and operating-system files
.vscode/
.idea/
.vs/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files and package artifacts
.cache/
.npm-cache/
.npm-pack-cache/
tmp/
temp/
*.tmp
*.bak
*.orig
*.tgz
artifacts/

# Crystal report binaries are private by default. Only reviewed fixtures may be committed.
*.rpt
*.rpt~
!tests/fixtures/crystal/*.rpt

# Proprietary implementation belongs in the other repository.
commercial-export/
packages/crystal-plugin/
workers/crystal-worker/
