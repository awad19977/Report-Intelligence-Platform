{
  "name": "@report-intelligence/core",
  "version": "0.1.0",
  "description": "Shared schemas, types, and utilities for the Report Intelligence Platform.",
  "license": "LGPL-3.0-only",
  "author": "Awad Emad",
  "homepage": "https://github.com/awad19977/Report-Intelligence-Platform#readme",
  "bugs": { "url": "https://github.com/awad19977/Report-Intelligence-Platform/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awad19977/Report-Intelligence-Platform.git",
    "directory": "packages/core"
  },
  "keywords": ["reporting", "schemas", "typescript", "zod"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
